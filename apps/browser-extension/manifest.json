{
	"manifest_version": 3,
	"name": "QRcodly",
	"description": "Generate and save QR codes directly from your browser",
	"action": {
		"default_popup": "index.html",
		"default_icon": { "48": "icon-48.png", "128": "icon-128.png" }
	},
	"permissions": ["activeTab", "storage", "cookies"],
	"host_permissions": ["https://api.qrcodly.de/*", "https://clerk.qrcodly.de/*"],
	"icons": { "48": "icon-48.png", "128": "icon-128.png" }
}
