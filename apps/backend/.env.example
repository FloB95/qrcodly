NODE_ENV="development"
COOKIE_SECRET="" #random string (32 characters)
JWT_SECRET="" #random string (32 characters)
REDIS_URL="redis://localhost:6379"

DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="db"
TEST_DB_NAME="db_test"
DB_PORT="3306"

LOG_LEVEL="debug"

# ethereal.email smtp
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# local minio
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west"
S3_UPLOAD_KEY=""
S3_UPLOAD_SECRET=""
S3_BUCKET_NAME="qrcodly"
S3_PUBLIC_URL="http://localhost:9000/qrcodly"
S3_PRIVATE_BUCKET_NAME="qrcodly-private"

TZ="Europe/Berlin"

AXIOM_DATASET="qrcodly"
AXIOM_TOKEN=""

# Internal API auth (shared secret between frontend and backend)
INTERNAL_API_SECRET="" #random string (64 hex characters / 32 bytes)

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID_MONTHLY=""
STRIPE_PRO_PRICE_ID_ANNUAL=""
STRIPE_ADDON_DOMAIN_PRICE_ID_MONTHLY=""
STRIPE_ADDON_DOMAIN_PRICE_ID_ANNUAL=""

# ClamAV daemon (clamd) that scans every uploaded file for malware.
# Required in production: without it production refuses uploads, development stores them unscanned.
# With a host set, an unreachable scanner rejects uploads instead of letting them through.
# clamd 1.x defaults fit (StreamMaxLength 100M > 50 MB uploads), but set `AlertExceedsMax yes`:
# otherwise a file above clamd's scan limits (MaxScanSize, MaxFileSize, MaxRecursion) comes back
# clean unscanned. Keep DetectPUA off (false positives) and give the container 3-4 GB of memory.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Hosted pages: days a replaced or removed file is kept before the hourly sweep deletes it.
HOSTED_FILE_RETENTION_DAYS="30"

# Google Web Risk API (URL safety check for redirect destinations).
# Optional — leave empty to skip the check (fail-open). Create a key in Google Cloud → Web Risk API.
GOOGLE_WEB_RISK_API_KEY=""

# Behaviour of the recurring safety re-check job.
#   shadow  = record findings, metrics and logs but never disable, notify or escalate (default)
#   enforce = actually block flagged links, mail the owner and run the warn->ban ladder
# Start in shadow, watch url_safety.blocks.total{mode="shadow"}, then switch to enforce.
URL_SAFETY_RECHECK_MODE="shadow"

# Session tokens whose `azp` (the origin Clerk issued them to) is not in FIRST_PARTY_ORIGINS.
#   shadow  = log them as auth.session.unauthorized-party, let them through (default)
#   enforce = treat the request as signed out
# Switch to enforce once the log has stayed empty for a while.
AUTHORIZED_PARTY_CHECK_MODE="shadow"

# Who gets the abuse alerts (auto-ban, repeat finding needing review, failed ban, block cap).
# Optional — defaults to info@fb-dev.de.
ABUSE_ALERT_MAIL=""

# Dedicated redirect domain for short links (e.g. https://qrco.ly). Optional — when unset,
# short links fall back to FRONTEND_URL. Isolating redirects on their own domain keeps a
# later Safe-Browsing flag on a destination from touching the brand domain.
SHORT_URL_BASE_URL=""

# Newsletter (listmonk). Optional — the feature is off until all four are set: no sync, and the
# settings endpoint answers "disabled". listmonk is the only place the subscription status lives.
# API user (listmonk → Users → new user of type "API") needs a user role with
#   subscribers:get_all, subscribers:manage, subscribers:sql_query, lists:get_all
# and a list role with get + manage on LISTMONK_LIST_ID (or lists:manage_all instead).
# Local instance: `pnpm run dev-server` starts listmonk on http://localhost:9002 (admin/listmonk-dev);
# create a single opt-in list there, then the API user, and put its id and token here.
# Initial backfill and manual run of the nightly sync (04:30), add --dry-run to only count:
#   local: pnpm cli newsletter-sync    backend pod: node build/src/cli.js newsletter-sync
# Left commented out: an empty value fails the env validation.
# LISTMONK_URL="http://localhost:9002"
# LISTMONK_API_USER="qrcodly-backend"
# LISTMONK_API_TOKEN=""
# LISTMONK_LIST_ID="1"
