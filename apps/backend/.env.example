NODE_ENV="development"
COOKIE_SECRET="" #random string (32 characters)
JWT_SECRET="" #random string (32 characters)
REDIS_URL="redis://localhost:6379"

DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="db"
TEST_DB_NAME="db_test"
DB_PORT="3306"

LOG_LEVEL="debug"

# ethereal.email smtp
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# local minio
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west"
S3_UPLOAD_KEY=""
S3_UPLOAD_SECRET=""
S3_BUCKET_NAME="qrcodly"
S3_PUBLIC_URL="http://localhost:9000/qrcodly"

TZ="Europe/Berlin"

AXIOM_DATASET="qrcodly"
AXIOM_TOKEN=""

# Internal API auth (shared secret between frontend and backend)
INTERNAL_API_SECRET="" #random string (64 hex characters / 32 bytes)

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID_MONTHLY=""
STRIPE_PRO_PRICE_ID_ANNUAL=""
STRIPE_ADDON_DOMAIN_PRICE_ID_MONTHLY=""
STRIPE_ADDON_DOMAIN_PRICE_ID_ANNUAL=""

# Google Web Risk API (URL safety check for redirect destinations).
# Optional — leave empty to skip the check (fail-open). Create a key in Google Cloud → Web Risk API.
GOOGLE_WEB_RISK_API_KEY=""

# Behaviour of the recurring safety re-check job.
#   shadow  = record findings, metrics and logs but never disable, notify or escalate (default)
#   enforce = actually block flagged links, mail the owner and run the warn->ban ladder
# Start in shadow, watch url_safety.blocks.total{mode="shadow"}, then switch to enforce.
URL_SAFETY_RECHECK_MODE="shadow"

# Who gets the abuse alerts (auto-ban, repeat finding needing review, failed ban, block cap).
# Optional — defaults to info@fb-dev.de.
ABUSE_ALERT_MAIL=""

# Dedicated redirect domain for short links (e.g. https://qrco.ly). Optional — when unset,
# short links fall back to FRONTEND_URL. Isolating redirects on their own domain keeps a
# later Safe-Browsing flag on a destination from touching the brand domain.
SHORT_URL_BASE_URL=""