{
	"name": "@apps/backend",
	"version": "1.0.0",
	"description": "QRcodly Backend App",
	"main": "src/index.ts",
	"type": "module",
	"private": true,
	"keywords": [],
	"author": "Florian Breuer",
	"license": "ISC",
	"engines": {
		"node": ">=22.11.0"
	},
	"scripts": {
		"lint": "eslint .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"pr:precheck": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
		"build": "tsc -p tsconfig.json && tsc-alias && tsc-esm-fix && node build/src/core/config/env.js && pnpm run copyMailerTemplates",
		"copyMailerTemplates": "cp -r ./src/core/mailer/templates ./build/src/core/mailer/templates",
		"start": "pnpm run db:migrate && TZ=Europe/Berlin node build/src/index.js",
		"dev-server": "docker-compose up -d",
		"dev": "pnpm run db:migrate && TZ=Europe/Berlin tsx watch --include ./src src/index.ts",
		"test": "export NODE_ENV=test && export NODE_OPTIONS=--experimental-vm-modules && export LOG_LEVEL=error && export FRONTEND_URL=https://test.qrcodly.de && pnpm run db:migrate && jest --maxWorkers=1 --workerIdleMemoryLimit=1536MB",
		"test:coverage": "export NODE_ENV=test && export LOG_LEVEL=error && export FRONTEND_URL=https://test.qrcodly.de && pnpm run db:migrate && jest --runInBand --coverage",
		"test:detectOpenHandles": "jest --silent --runInBand --detectOpenHandles",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:migrate": "DB_MIGRATING=true tsx src/core/db/migrate.ts",
		"db:generate-migration": "drizzle-kit generate --config=drizzle.config.ts",
		"studio": "drizzle-kit studio",
		"cli": "npx tsx src/cli.ts",
		"cli:list": "npx tsx src/cli.ts list",
		"script:find-orphaned-urls": "SKIP_ENV_VALIDATION=true tsx scripts/find-orphaned-short-urls.ts",
		"script:test-smtp": "tsx scripts/test-smtp.ts",
		"script:preview-emails": "SKIP_ENV_VALIDATION=true tsx scripts/send-test-emails.ts",
		"script:seed-safety-demo": "SKIP_ENV_VALIDATION=true tsx scripts/seed-url-safety-demo.ts",
		"script:regenerate-previews": "SKIP_ENV_VALIDATION=true tsx scripts/regenerate-preview-images.ts"
	},
	"devDependencies": {
		"@aws-sdk/types": "^3.974.2",
		"@faker-js/faker": "^9.9.0",
		"@types/jest": "^30.0.0",
		"@types/jsdom": "^21.1.7",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node-cron": "^3.0.11",
		"@types/nodemailer": "^8.0.1",
		"@types/qs": "^6.15.1",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"@typescript-eslint/parser": "catalog:",
		"drizzle-kit": "^0.31.10",
		"esbuild": "~0.28.1",
		"eslint-plugin-drizzle": "^0.2.3",
		"form-data": "^4.0.6",
		"get-tsconfig": "^4.14.0",
		"jest-mock-extended": "4.0.1",
		"qrcodly-eslint-config": "workspace:*",
		"qrcodly-typescript-config": "workspace:*",
		"ts-jest": "^29.4.11",
		"ts-jest-mock-import-meta": "^1.3.2",
		"tsc-alias": "^1.9.1",
		"tsc-esm-fix": "^3.1.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.64.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1088.0",
		"@aws-sdk/s3-request-presigner": "^3.1088.0",
		"@axiomhq/pino": "^1.8.0",
		"@clerk/fastify": "^3.1.52",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "catalog:",
		"@fastify/csrf-protection": "^8.0.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/multipart": "^10.1.0",
		"@fastify/otel": "^0.20.1",
		"@fastify/rate-limit": "^11.1.0",
		"@fastify/swagger": "^9.8.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.220.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
		"@opentelemetry/host-metrics": "^0.39.0",
		"@opentelemetry/instrumentation-http": "^0.220.0",
		"@opentelemetry/resources": "^2.9.0",
		"@opentelemetry/sdk-metrics": "^2.9.0",
		"@opentelemetry/sdk-node": "^0.220.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@qrcodly/db": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@sentry/node": "catalog:",
		"@shared/schemas": "workspace:^",
		"commander": "^15.0.0",
		"csv-parse": "^7.0.1",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"fastify": "catalog:",
		"handlebars": "^4.7.9",
		"ioredis": "^5.11.1",
		"jsdom": "^26.1.0",
		"jsonwebtoken": "^9.0.3",
		"mysql2": "^3.23.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.0.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"qr-code-styling": "^1.9.2",
		"qs": "^6.15.3",
		"reflect-metadata": "^0.2.2",
		"sharp": "^0.35.3",
		"stripe": "^22.3.2",
		"svix": "^1.97.0",
		"tsyringe": "^4.10.0",
		"zod": "catalog:",
		"zod-to-json-schema": "^3.25.2",
		"zod-validation-error": "^5.0.0"
	}
}
