{
	"compilerOptions": {
		"target": "ES2017",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2017"],
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true,
		"typeRoots": ["./node_modules/@figma"],
		"types": ["plugin-typings"]
	},
	"include": ["src/plugin/**/*", "src/shared/**/*"],
	"exclude": ["node_modules", "dist"]
}
