# QRcodly API the MCP tools proxy to
QRCODLY_API_BASE_URL="https://api.qrcodly.de"

PORT=3002
HOST="0.0.0.0"
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Axiom — BOTH must be set or MCP usage is logged to stdout only and never
# reaches the dashboard. Use the same dataset as the backend ("qrcodly") so
# MCP rows sit next to backend and frontend traffic; they are told apart by
# the pino logger name ("mcp-log" vs "backend-log").
AXIOM_DATASET="qrcodly"
AXIOM_TOKEN=""
