# =============================================================================
# QRcodly load test — copy to .env (gitignored) and fill in.
# =============================================================================

# --- Target (defaults: production) ---
API_URL=https://api.qrcodly.de/api/v1
FRONTEND_URL=https://www.qrcodly.de
# Host the QR short links point to, if NEXT_PUBLIC_SHORT_URL_DOMAIN is set (defaults to FRONTEND_URL)
SCAN_URL=

# --- Clerk: keys of the SAME instance the target uses (Dashboard → API keys) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Test users ---
# Default for ./run.sh provision; you need at least as many as concurrent users.
LOADTEST_USERS=200
# Emails of the test accounts; a domain without mailboxes, nobody receives anything.
LOADTEST_EMAIL_DOMAIN=loadtest.qrcodly.de

# --- Load shape (all optional) ---
# Concurrent users: constant for load/soak/baseline, the maximum for stress/spike
USERS=
# Stress steps instead of 10/25/50/75/100 % of USERS, e.g. 50,100,200,400,800
STEPS=
# Seconds or durations like 90s / 5m, per step
RAMP=
HOLD=
# Think-time multiplier: 0.5 = users click twice as fast
THINK=1
# 0 = API calls only, skip rendering the Next.js pages
PAGE_LOADS=1
# Public QR scans per second (0 = off). Scans are rate-limited per IP: stay ≤ 2 from one machine.
SCAN_RATE=0
# 1 = every destination URL unique (each costs a Google Web Risk lookup)
UNIQUE_URLS=0

# --- Capacity verdict: a step passes if all of these hold ---
SLO_API_P95_MS=800
SLO_PAGE_P95_MS=2500
SLO_ERROR_RATE=0.01

# --- Seed data per test user (./run.sh seed) ---
SEED_QR_CODES=8
SEED_SHORT_URLS=1
SEED_TAGS=3
SEED_TEMPLATES=1
